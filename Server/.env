# Local SQLite dev database for stable local testing
DATABASE_URL="file:./prisma/dev.db"


DIRECT_URL="file:./prisma/dev.db"

# Use a strong JWT secret for local dev (rotate in production)
JWT_SECRET="change_this_to_a_strong_secret_please_replace"

# Disable real email sending during automated tests
EMAIL_DISABLE=true

PORT=5000
NODE_ENV=development

FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

USE_COOKIES=true
ADMIN_EMAIL="admin@example.com"