# Database Configuration
DATABASE_URL='postgresql://neondb_owner:****************@ep-morning-lake-adwr75jy-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# JWT Configuration
JWT_SECRET="change_this_to_a_strong_secret_minimum_32_characters"

# Email Configuration (SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS and email links)
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Cookie Configuration (optional - set to 'true' to use HttpOnly cookies)
USE_COOKIES=false

# Admin Email (optional - for notifications)
ADMIN_EMAIL="admin@example.com"
