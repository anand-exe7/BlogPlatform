# Database Configuration
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/blogplatform_dev"

# JWT Configuration
JWT_SECRET="change_this_to_a_random_hex_string_at_least_64_characters_long"
JWT_REFRESH_SECRET="change_this_to_a_different_random_hex_string"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET="change_this_to_a_random_base64_string"
USE_COOKIES=true

# Seed — super admin created on first deploy
ADMIN_EMAIL=president@yourcollege.edu
ADMIN_PASSWORD=ChangeThisNow@2026!
ADMIN_NAME=Club President

# Email Configuration (SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_DISABLE=false

# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URL (for CORS and email links)
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Admin Email (for seed script and notifications)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@123456"
