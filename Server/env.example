# Database Configuration
DATABASE_URL='DATABASE_URL='postgresql://postgres:#Vin2004@localhost:5432/postgres''

# JWT Configuration
JWT_SECRET="change_this_to_a_strong_secret_minimum_32_characters"

# Email Configuration (SMTP)
